NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional database administration connection for migrations. Keep local only.
# Supabase Connect -> Session pooler (port 5432), postgres credentials, URL-encoded password.
SUPABASE_DB_URL=
SUPABASE_DB_CA_FILE=
# Optional LOCAL proxy. Never copy localhost proxy settings to Vercel.
# Use Node 24.5+ to honor these values before process initialization.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=
# Only for isolated integration tests; never NEXT_PUBLIC_ or production accounts
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
